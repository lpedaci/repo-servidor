---
import '../styles/global.css';
import '../styles/motion.css';
import Sprite from '../components/Sprite.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../lib/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  actual?: string;
  noindex?: boolean;
  og?: string;
  tipo?: 'website' | 'article';
}
const { titulo, descripcion = SITE.descripcion, actual, noindex = false, og = 'og/og.png', tipo = 'website' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nombre}` : `${SITE.nombre}: ${SITE.lema.replace(/\.$/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImg = new URL(url(og), Astro.site).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={`${SITE.autora}, ${SITE.firma}`} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e9e8f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131316" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preload" href={url('/fonts/outfit.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/geist.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={titulo ?? SITE.nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${titulo ?? SITE.nombre}. Un gatito negro duerme arriba de un servidor.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImg} />

    <script is:inline>
      // Tema y JS disponibles antes de pintar: evita el parpadeo.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('server:tema');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Sprite />
    <TopBar actual={actual} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <p class="sr-only" role="status" data-toast-sr></p>
    <div class="toast" aria-hidden="true" data-toast>
      <span class="dot-ic"><svg class="ic" aria-hidden="true"><use href="#i-star"></use></svg></span>
      <span data-toast-txt></span>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
