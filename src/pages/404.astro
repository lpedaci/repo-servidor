---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';
---

<Base titulo="Te caíste del mapa" descripcion="Esta página no existe." noindex>
  <div class="wrap">
    <section class="lost stagger" aria-labelledby="lost-t">
      <div class="tile tile--t2" style="--i:0">
        <svg class="gato" viewBox="0 64 540 262" aria-hidden="true" focusable="false">
          <path class="gato-mensula" d="M92 214 V246 L128 214 M448 214 V246 L412 214" />
          <rect class="gato-estante" x="16" y="200" width="508" height="14" rx="7" />
          <g class="gato-almohadon" transform="rotate(-3 92 150)">
            <rect x="36" y="94" width="112" height="106" rx="30" />
            <rect class="gato-costura" x="46" y="104" width="92" height="86" rx="22" />
            <text x="92" y="179">4</text>
          </g>
          <g class="gato-almohadon" transform="rotate(4 450 154)">
            <rect x="396" y="102" width="108" height="98" rx="30" />
            <rect class="gato-costura" x="406" y="112" width="88" height="78" rx="22" />
            <text x="450" y="183" style="font-size:80px">4</text>
          </g>
          <g class="gato-colgante">
            <g class="gato-ovillo">
                            <circle class="gato-ovillo-bola" cx="350" cy="286" r="27" />
              <path class="gato-hebras" d="M328 272 C 344 266, 364 270, 374 282 M326 296 C 342 304, 362 304, 375 294 M338 262 C 334 276, 334 296, 340 310" />
              <text x="350" y="306" style="font-size:56px">0</text>
            </g>
            <path class="gato-cola" d="M362 194 C 390 200, 396 226, 386 244 C 380 254, 368 254, 370 245" />
            <path class="gato-hilo" d="M384 240 C 380 250, 368 254, 358 260" />
            <path class="gato-hilo" d="M385 228 L398 233 M383 235 L396 240" />
          </g>
          <g class="gato-dormido">
            <path class="gato-negro" d="M196 201 C 194 124, 374 118, 378 201 Z" />
            <path class="gato-negro" d="M178 166 L180 130 L204 150 Z" />
            <path class="gato-negro gato-oreja-der" d="M210 148 L232 132 L236 166 Z" />
            <path class="gato-oreja-in" d="M184 156 L185 140 L196 150 Z M216 148 L228 140 L230 156 Z" />
            <ellipse class="gato-negro" cx="206" cy="176" rx="33" ry="27" />
            <path class="gato-cerrado" d="M187 176 q7 6 14 0" />
            <path class="gato-cerrado gato-cerrado-der" d="M211 176 q7 6 14 0" />
            <g class="gato-espia">
              <ellipse class="gato-iris" cx="218" cy="175" rx="5.6" ry="5" />
              <ellipse class="gato-pupila" cx="217.4" cy="175" rx="1.6" ry="4.2" />
            </g>
            <path class="gato-nariz" d="M202.5 186 h7 l-3.5 3.6 Z" />
            <path class="gato-bigote" d="M192 189 L166 185 M192 192 L167 197 M220 189 L246 185 M220 192 L245 197" />
            <ellipse class="gato-negro" cx="238" cy="198" rx="16" ry="6" />
          </g>
          <g class="gato-zzz">
            <text x="178" y="122">z</text>
            <text x="160" y="100">z</text>
            <text x="146" y="78">z</text>
          </g>
        </svg>
      </div>
      <div class="panel" style="--i:1;display:flex;flex-direction:column;justify-content:center;gap:1rem">
        <p class="kicker"><Icon name="gamepad" /> Error 404</p>
        <h1 id="lost-t" style="font-size:clamp(2rem,4.4vw,3.2rem)">Te caíste del mapa</h1>
        <p class="lead muted" style="margin:0;font-size:1.15rem">Logro desbloqueado: encontraste al gatito que administra el server (está en su siesta de mantenimiento). La página que buscabas no existe o se mudó, pero ganaste una vida extra. ¿La usás para hacer respawn en el Lobby?</p>
        <div class="chips" style="margin-top:0.5rem">
          <a class="btn btn--primary" href={url('/')}>Volver al Lobby <Icon name="house" /></a>
          <a class="btn" href={url('/buscar/')}><Icon name="search" /> Buscar</a>
        </div>
      </div>
    </section>
  </div>
</Base>
